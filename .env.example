# Template only: the Go app reads exported environment variables.
ARIA_MODE=demo
PORT=4180
PUBLIC_URL=http://127.0.0.1:4180
ARIA_DATA_DIR=data

# Required in sandbox mode. Independent random values, >=32 characters each.
ARIA_SESSION_SECRET=
# Agent credential: the MCP bridge (the AI agent) sends it as a bearer token.
# It can read the catalogue and draft orders; it can never approve, capture or refund.
ARIA_MERCHANT_TOKEN=
# Human merchant login for the browser (/api/login). Must differ from
# ARIA_MERCHANT_TOKEN; the service refuses to start if they are equal. Never put
# it in the agent's shell or MCP configuration. Empty in demo mode disables login.
ARIA_MERCHANT_LOGIN_TOKEN=
ARIA_MERCHANT_ID=store-1
# Optional transition alias: original owner hash, never a token or secret.
ARIA_LEGACY_MERCHANT_OWNER=
# Optional trusted JSON file used only until a persisted catalogue exists.
ARIA_CATALOG_FILE=

# Sandbox credentials only. Live PayPal endpoints are not supported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional for checkout, required for incoming webhooks.
PAYPAL_WEBHOOK_ID=
# Optional: PAYPAL_BUTTONS=1 shows PayPal's own buttons in the page instead of redirecting.
# The server still creates, captures and verifies the order. Sandbox client IDs only.
# PAYPAL_BUTTONS=1

# Choose an available model ID supporting JSON object output from /v1/models.
# Local use only: set ARIA_AI=aria to draft with the model your signed-in Aria Code
# account already has (no AI key needed; run /login first). Refused on Cloud Run/Vercel.
# ARIA_AI=aria
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN supplied by Vercel can replace AI_GATEWAY_API_KEY.

# Required for Vercel or multiple instances; use a read/write token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Aria MCP bridge configuration.
ARIA_COMMERCE_URL=http://127.0.0.1:4180
# Set a literal absolute binary path in Aria's mcp_servers.json (see docs).
# Containers only: listen on all interfaces.
ARIA_BIND_ALL=0

# Local default: file. Cloud Run services/jobs default to firestore.
# Cloud Run always rejects ephemeral file storage.
ARIA_STORE=file
GOOGLE_CLOUD_PROJECT=
ARIA_FIRESTORE_DATABASE='(default)'
ARIA_FIRESTORE_COLLECTION=aria_commerce_records
# Firestore uses Application Default Credentials; no service-account JSON is needed on Cloud Run.

# Shared quotas: per-owner/per-minute, global/per-minute, global/per-UTC-day,
# per-owner/per-UTC-day, login attempts per direct peer/per-minute.
ARIA_DRAFT_LIMIT=10
ARIA_GLOBAL_DRAFT_LIMIT=120
ARIA_DAILY_DRAFT_LIMIT=500
ARIA_OWNER_DAILY_DRAFT_LIMIT=50
ARIA_LOGIN_LIMIT=10

# Optional private Cloud Run MCP invocation; the SDK refreshes ID tokens via ADC.
# The service's canonical HTTPS URL is the audience, including for tagged revisions.
ARIA_CLOUD_RUN_AUDIENCE=

